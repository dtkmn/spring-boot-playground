POSTGRES_PASSWORD=
# Create two different random tokens with at least 32 characters each.
PILOT_CALLER_A_TOKEN=
PILOT_CALLER_B_TOKEN=
# The default starts the authenticated Order API without a model.
PILOT_PROFILES=docker
# Opt in with PILOT_PROFILES=docker,ai; this never downloads a model.
OLLAMA_MODEL=qwen3.5:4b
# Optional overrides for local port conflicts; all exports bind to loopback:
# POSTGRES_DB=__ARTIFACT_ID__
# POSTGRES_USER=postgres
# POSTGRES_EXPORT_PORT=5432
# APP_HOST_PORT=__APP_PORT__
# MANAGEMENT_HOST_PORT=__MANAGEMENT_PORT__
